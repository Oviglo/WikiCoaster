{% extends "base.html.twig" %}

{% block body %}
<div class="flex justify-end my-4">
    <a class="btn btn-neutral" href="{{ path('app_coaster_add') }}">Nouveau coaster</a>
</div>
<div>
    <form method="GET">
        <select class="select" name="park">
            <option value="">Tout les parcs</option>
            {% for p in parks %}
            <option value="{{ p.id }}">{{ p.name }}</option>
            {% endfor %}
        </select>
        <select class="select ms-1" name="category">
            <option value="">Toutes les catégories</option>
            {% for c in categories %}
            <option value="{{ c.id }}">{{ c.name }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-neutral ms-1">Filtrer</button>
    </form>
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Long.</th>
                <th>Haut. Max.</th>
                <th>Vit. Max.</th>
                <th>Parc</th>
                <th>Catégories</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            {%  for coaster in coasters %}
            <tr>
                <td><strong>{{  coaster.name }}</strong></td>
                <td>{{  coaster.length }}</td>
                <td>{{  coaster.maxHeight }}</td>
                <td>{{  coaster.maxSpeed }}</td>
                <td>{{ coaster.park }}</td>
                <td>
                    {%  for cat in coaster.categories %}
                    <span class="badge me-1">{{ cat }}</span>
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('app_coaster_edit', { id: coaster.id }) }}" class="btn btn-sm">Modifier</a>
                    <a href="{{ path('app_coaster_delete', { id: coaster.id }) }}" class="btn btn-sm btn-error ms-1">Supprimer</a>
                    <a href="{{ path('app_coaster_generatedescription', { id: coaster.id }) }}" class="btn btn-sm btn-accent ms-1">Générer la description</a>
                </td>
            </tr>
            {%  endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
